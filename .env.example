# Fill these values in your MCP host's secret/environment settings.
SF_PARTNER_ID=replace-with-your-sf-partner-id
SF_CHECK_WORD=replace-with-your-sf-check-word
SF_ENV=sandbox
# Use simple when the SF console selects 简易MD5; standard uses URL encoding before MD5.
SF_SIGN_MODE=standard
SF_HTTP_TIMEOUT=10
# Optional local SQLite path for 24-hour order ID / waybill mappings.
# SF_ORDER_MAP_PATH=C:\path\to\order-map.sqlite3
# Production orders require both SF_ENV=production and this explicit switch.
SF_ALLOW_PRODUCTION_ORDERS=false
